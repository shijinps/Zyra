{
    "name": "Zyra Spatial Intelligence",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "zyra/spatial-query",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "webhook-spatial-query",
            "name": "Webhook - Spatial Query",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1.1,
            "position": [
                240,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Extract query parameters\nconst currentLat = $input.item.json.current_lat;\nconst currentLng = $input.item.json.current_lng;\nconst destinationLat = $input.item.json.destination_lat;\nconst destinationLng = $input.item.json.destination_lng;\nconst destinationName = $input.item.json.destination_name || 'destination';\nconst placeType = $input.item.json.place_type || 'atm';\nconst maxDetourMinutes = $input.item.json.max_detour_minutes || 2;\n\nreturn {\n  current_lat: currentLat,\n  current_lng: currentLng,\n  destination_lat: destinationLat,\n  destination_lng: destinationLng,\n  destination_name: destinationName,\n  place_type: placeType,\n  max_detour_minutes: maxDetourMinutes\n};"
            },
            "id": "parse-query",
            "name": "Parse Query",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                460,
                300
            ]
        },
        {
            "parameters": {
                "url": "=https://maps.googleapis.com/maps/api/directions/json?origin={{$json.current_lat}},{{$json.current_lng}}&destination={{$json.destination_lat}},{{$json.destination_lng}}&mode=driving&key=AIzaSyAnV4qvtqRnDZ7Akjbu5oQ6TXi-bJmN8b4",
                "options": {}
            },
            "id": "get-route",
            "name": "Get Route",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Decode polyline and sample route points\nfunction decodePolyline(encoded) {\n  const points = [];\n  let index = 0, len = encoded.length;\n  let lat = 0, lng = 0;\n  \n  while (index < len) {\n    let b, shift = 0, result = 0;\n    do {\n      b = encoded.charCodeAt(index++) - 63;\n      result |= (b & 0x1f) << shift;\n      shift += 5;\n    } while (b >= 0x20);\n    const dlat = ((result & 1) ? ~(result >> 1) : (result >> 1));\n    lat += dlat;\n    \n    shift = 0;\n    result = 0;\n    do {\n      b = encoded.charCodeAt(index++) - 63;\n      result |= (b & 0x1f) << shift;\n      shift += 5;\n    } while (b >= 0x20);\n    const dlng = ((result & 1) ? ~(result >> 1) : (result >> 1));\n    lng += dlng;\n    \n    points.push({ lat: lat / 1e5, lng: lng / 1e5 });\n  }\n  return points;\n}\n\nconst polyline = $input.item.json.routes[0].overview_polyline.points;\nconst allPoints = decodePolyline(polyline);\n\n// Sample every 2km (approximately every 20 points)\nconst sampledPoints = [];\nfor (let i = 0; i < allPoints.length; i += 20) {\n  sampledPoints.push(allPoints[i]);\n}\n\nreturn sampledPoints.map(point => ({\n  lat: point.lat,\n  lng: point.lng,\n  place_type: $input.item.json.place_type,\n  keyword: $input.item.json.keyword || ''\n}));"
            },
            "id": "sample-route-points",
            "name": "Sample Route Points",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                900,
                300
            ]
        },
        {
            "parameters": {
                "url": "=https://maps.googleapis.com/maps/api/place/nearbysearch/json?location={{$json.lat}},{{$json.lng}}&radius=1000&type={{$json.place_type}}&keyword={{$json.keyword}}&key=AIzaSyAnV4qvtqRnDZ7Akjbu5oQ6TXi-bJmN8b4",
                "options": {}
            },
            "id": "search-places",
            "name": "Search Places",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1120,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Aggregate and deduplicate places\nconst allPlaces = [];\nconst seenPlaceIds = new Set();\n\nfor (const item of $input.all()) {\n  const results = item.json.results || [];\n  for (const place of results) {\n    if (!seenPlaceIds.has(place.place_id)) {\n      seenPlaceIds.add(place.place_id);\n      allPlaces.push({\n        name: place.name,\n        address: place.vicinity,\n        lat: place.geometry.location.lat,\n        lng: place.geometry.location.lng,\n        rating: place.rating,\n        is_open: place.opening_hours?.open_now\n      });\n    }\n  }\n}\n\nreturn [{ json: { places: allPlaces, count: allPlaces.length } }];"
            },
            "id": "aggregate-places",
            "name": "Aggregate Places",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1340,
                300
            ]
        },
        {
            "parameters": {
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "groqApi",
                "url": "https://api.groq.com/openai/v1/chat/completions",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "llama-3.3-70b-versatile"
                        },
                        {
                            "name": "messages",
                            "value": "=[{\"role\": \"system\", \"content\": \"You are Zyra, a helpful voice assistant. Summarize the following places in a natural, conversational way. Mention the top 3 results with their names, detour times, and ratings. Keep it concise for voice output.\"}, {\"role\": \"user\", \"content\": \"Places found: \" + JSON.stringify($json.places)}]"
                        },
                        {
                            "name": "temperature",
                            "value": "0.7"
                        }
                    ]
                },
                "options": {}
            },
            "id": "groq-summarize",
            "name": "Groq - Summarize",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1560,
                300
            ]
        },
        {
            "parameters": {
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "url": "https://api.elevenlabs.io/v1/text-to-speech/21m00Tcm4TlvDq8ikWAM",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "text",
                            "value": "={{$json.choices[0].message.content}}"
                        },
                        {
                            "name": "model_id",
                            "value": "eleven_monolingual_v1"
                        }
                    ]
                },
                "options": {}
            },
            "id": "elevenlabs-tts",
            "name": "ElevenLabs TTS",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1780,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ { \"summary\": $('Groq - Summarize').item.json.choices[0].message.content, \"audio_url\": \"data:audio/mpeg;base64,\" + $binary.data.toString('base64'), \"places_count\": $('Aggregate Places').item.json.count } }}"
            },
            "id": "respond-to-webhook",
            "name": "Respond to Webhook",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                2000,
                300
            ]
        }
    ],
