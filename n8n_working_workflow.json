                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarize these places in 2-3 sentences for voice output: {{ $json.results.slice(0, 5).map(p => p.name).join(', ') }}\"\n    }\n  ]\n}",
