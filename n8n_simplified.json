        },
        {
            "parameters": {
                "jsCode": "const places = $input.item.json.results.slice(0, 5).map(p => p.name).join(', ');\n\nreturn {\n  prompt: `Summarize these restaurants in 2-3 sentences for voice: ${places}`\n};"
