            "parameters": {
                "jsCode": "const groqData = $('Groq AI').item.json;\nconst mapsData = $('Google Maps').item.json;\nconst audioData = $binary.data;\n\nreturn {\n  summary: groqData.choices[0].message.content,\n  audio_base64: audioData.toString('base64'),\n  place_count: mapsData.results.length,\n  places: mapsData.results.slice(0, 5).map(p => ({\n    name: p.name,\n    rating: p.rating || 0,\n    vicinity: p.vicinity || ''\n  }))\n};"
            },
